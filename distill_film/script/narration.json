   "id": "dark", "chapter": "02", "title": "暗知识", "pre": 1.2, "post": 0.6,
   "lines": [
    {"id": "dk1", "style": "base", "gap": 0.5, "snap": ["p0", "bar"],
     "say": "学生要学的，|不只是标准答案。",
     "sub": "学生要学的|不只是标准答案"},
    {"id": "dk2", "style": "base", "gap": 0.5,
     "say": "给教师看一张宝马车的照片，|它会说：|这是汽车。",
     "sub": "给教师看一张宝马车的照片|它会说|这是汽车"},
    {"id": "dk3", "style": "base", "gap": 0.7,
     "say": "但它的答案里，还藏着更多：|这张图，有一点点像垃圾车，|却几乎不可能是胡萝卜。",
     "sub": "但它的答案里，还藏着更多|这张图，有一点点像垃圾车|却几乎不可能是胡萝卜"},
    {"id": "dk4", "style": "base", "gap": 0.9, "snap": ["p2", "beat"],
     "say": "这些“错误答案”之间的细微差别，|辛顿称之为——|“暗知识”。",
     "sub": "这些「错误答案」之间的细微差别|辛顿称之为|「暗知识」"},
    {"id": "dk5", "style": "base", "gap": 0.5,
     "say": "可它们太微弱了。|怎么把它提炼出来？",
     "sub": "可它们太微弱了|怎么把它提炼出来？"},
    {"id": "dk6", "style": "wow", "gap": 0.8, "snap": ["p1", "beat"],
     "say": "答案是：|加热。",
     "sub": "答案是|加热"},
    {"id": "dk7", "style": "base", "gap": 0.6,
     "say": "给输出加上一个“温度”。|温度越高，|分布就越柔和，|那些藏在角落里的关系，|就浮出了水面。",
     "sub": "给输出加上一个「温度」|温度越高|分布就越柔和|那些藏在角落里的关系|就浮出了水面"},
    {"id": "dk8", "style": "base", "gap": 0.9,
     "say": "学生模仿这份“加热”过的答案，|学会的不只是“是什么”，|还有“像什么”。",
     "sub": "学生模仿这份「加热」过的答案|学会的不只是「是什么」|还有「像什么」"},
    {"id": "dk9", "style": "base", "gap": 1.1,
     "say": "在辛顿的实验里，|训练数据中所有的“三”，|都被拿走了。|对学生来说，|“三”只是一个传说。",
     "sub": "在辛顿的实验里|训练数据中所有的「3」|都被拿走了|对学生来说|「3」只是一个传说"},
    {"id": "dk10", "style": "wow", "gap": 0.0, "snap": ["p2", "bar"],
     "say": "可仅凭老师的暗知识，|稍加校准，|它认出了百分之九十八点六的“三”。",
     "sub": "可仅凭老师的暗知识|稍加校准|它认出了 98.6% 的「3」"}
